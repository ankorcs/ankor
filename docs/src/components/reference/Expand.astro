---
/** Opens or closes every field below it at once. */
---

<button type="button" class="expand" data-reference-expand>Expand all</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-reference-expand]')) {
    button.addEventListener('click', () => {
      const scope = button.closest('section') ?? document;
      const open = button.textContent === 'Expand all';

      for (const details of scope.querySelectorAll('details.tree')) {
        (details as HTMLDetailsElement).open = open;
      }

      button.textContent = open ? 'Collapse all' : 'Expand all';
    });
  }
</script>

<style>
  .expand {
    margin-left: auto;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    color: var(--color-text-300);
    background: none;
    border: 1px solid var(--color-line-700);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .expand:hover {
    color: var(--color-text-100);
    border-color: var(--color-text-500);
  }
</style>
