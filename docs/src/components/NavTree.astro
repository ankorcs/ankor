---
/** One level of the sidebar; groups nest, and the current page's group opens. */
import { isGroup, type NavItem } from '../nav.ts';

interface Props {
  items: NavItem[];
  current: string;
  depth?: number;
}

const { items, current, depth = 0 } = Astro.props;

function contains(item: NavItem): boolean {
  return isGroup(item) ? item.items.some(contains) : item.href === current;
}
---

<ul class:list={['nav', depth > 0 && 'nested']}>
  {items.map((item) => isGroup(item) ? (
    <li>
      {depth === 0 ? (
        <p class="group caps">{item.label}</p>
        <Astro.self items={item.items} current={current} depth={depth + 1} />
      ) : (
        <details open={contains(item)}>
          <summary>{item.label}</summary>
          <Astro.self items={item.items} current={current} depth={depth + 1} />
        </details>
      )}
    </li>
  ) : (
    <li>
      <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>{item.label}</a>
    </li>
  ))}
</ul>

<style>
  .nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nested {
    margin-top: 0.25rem;
  }

  details .nested {
    margin-left: 0.75rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--color-line-800);
  }

  li + li {
    margin-top: 0.125rem;
  }

  .group {
    margin: 1.75rem 0 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-500);
  }

  li:first-child > .group {
    margin-top: 0;
  }

  /* A line above each section but the first, so the groups read apart. */
  li:not(:first-child) > .group {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-800);
  }

  a,
  summary {
    display: block;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    color: var(--color-text-300);
    text-decoration: none;
  }

  summary {
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '▸';
    float: right;
    color: var(--color-text-700);
  }

  details[open] > summary::after {
    content: '▾';
  }

  a:hover,
  summary:hover {
    color: var(--color-text-100);
    background: var(--color-bg-800);
  }

  a[aria-current='page'] {
    color: var(--color-text-100);
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-accent-600) 40%, transparent), color-mix(in srgb, var(--color-accent-600) 10%, transparent));
    box-shadow: inset 2px 0 0 var(--color-accent-400);
  }
</style>
